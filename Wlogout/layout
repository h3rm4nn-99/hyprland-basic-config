{
    "label" : "lock",
    "action" : "hyprlock --immediate",
    "text" : "Blocca",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Iberna",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "sleep 1; hyprctl dispatch exit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Arresta",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Sospendi",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Riavvia",
    "keybind" : "r"
}
