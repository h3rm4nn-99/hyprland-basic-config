// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
	"hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "tray",
	"pulseaudio",
	"clock",
    "custom/power-off-button"
   ],
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M %d/%m/%Y}"
    },
    "cpu": {
        "format": "CPU: {usage}% - {avg_frequency}GHz",
	"interval": 5,
        "tooltip": false
    },
    "memory": {
        "format": "Mem: {}%",
	"tooltip": true,
	"tooltip-format": "Memoria utilizzata: {used}GB"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "Temp: {temperatureC}°C",
        "format-icons": ["", "", ""],
	"tooltip": false
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "Lum: {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
	"tooltip": false
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
	"tooltip": false,
	"format": "Bat: {capacity}%",
        "format-full": "Carica",
        "format-charging": "In carica: {capacity}%",
        "format-plugged": "Collegato : {capacity}%",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
      "format": "{icon} {profile}",
      "tooltip-format": "Driver utilizzato: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " ",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    //  (non chiedere)
    "custom/power-off-button": {
        "format": " {}",
        "exec": "echo $USER",
        "interval": "once",
        "on-click": "wlogout",
        "tooltip": true,
        "tooltip-format": "Chiudi sessione"
    }

}
